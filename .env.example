ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Your ngrok hostname, no scheme, e.g. "abc123.ngrok-free.app" — see
# transport/telephony.py
PUBLIC_HOSTNAME=
VOYAGE_API_KEY=
# Phase 11 — escalation notifications (n8n). Optional: unset means a silent
# no-op, same as every other optional integration in this project.
ESCALATION_WEBHOOK_URL=
ESCALATION_WEBHOOK_SECRET=
# Phase 10d — warm handoff. The human agent's phone, E.164 format. Unset means
# no transfer is attempted and the agent behaves as it did before Phase 10d.
# Any E.164 number works: a US Twilio number (~$0.014/min) or a Voice SDK
# browser client tests the identical code path far more cheaply than
# international mobile termination (Serbian mobile is $0.8211/min).
HUMAN_AGENT_NUMBER=
# Caller ID presented on the outbound leg. MUST be a Twilio-owned number —
# the customer's own number cannot legally be presented.
TWILIO_CALLER_ID=
# TWILIO_ACCOUNT_SID above (Phase 9) is reused here — it's what the REST
# client that issues the transfer redirect authenticates with.
